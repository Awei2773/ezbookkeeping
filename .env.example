# ezBookkeeping development environment variables.
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored (see .gitignore: ".env" and "**/.env"); never commit it.
# Every setting here maps to conf/ezbookkeeping.ini through the EBK_<SECTION>_<ITEM>
# convention (uppercase). See pkg/settings/setting.go for the full mapping.

# Timezone used by the containers (logging, scheduled jobs). Default UTC.
TZ=Asia/Shanghai

# Domain used to build the server root_url (server.domain in the ini).
EBK_SERVER_DOMAIN=localhost

# Signing secret (security.secret_key in the ini). REQUIRED before exposing the
# app to anything but localhost. Generate a random one with:
#   openssl rand -hex 32
# Leave empty only for a first local run; the app logs a warning if unset.
EBK_SECURITY_SECRET_KEY=

# Database type: sqlite3 (default) | mysql | postgres
EBK_DATABASE_TYPE=sqlite3

# Go module proxy. proxy.golang.org (Google) and github.com over HTTPS are
# unreachable from this NAS; default to goproxy.io with the online checksum DB
# disabled (go.sum is still enforced). Leave unset unless your network changes.
# GOPROXY=https://goproxy.io,direct
# GOSUMDB=off
